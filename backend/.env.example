# ──────────────────────────────────────────────
# Urjasetu Environment Variables
# ──────────────────────────────────────────────

# MongoDB Atlas
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGO_URI=mongodb+srv://<username>:<password>@urjasetu.2f5foqc.mongodb.net/?retryWrites=true&w=majority&appName=urjasetu
MONGO_DB_NAME=urjasetu_database

# LLM (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string

# ML Service
ML_SERVICE_URL=http://localhost:8001

# Frontend
CLIENT_URL=http://localhost:3000
REACT_APP_API_URL=

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# RAG Enhancements (optional)
TAVILY_API_KEY=
LANGCHAIN_API_KEY=
